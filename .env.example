# Configuration for the board. Copy to .env for local docker compose, or add
# these keys to sops (see deploy/README.md in Dev-kit) for the server.
#
# Never commit the real file.

# --- Required -------------------------------------------------------------
# Public URL the browser uses. The OIDC callback is
# {BOARD_PUBLIC_URL}/api/auth/callback.
BOARD_PUBLIC_URL=http://localhost:8080

# Pocket ID client (Settings -> Admin -> OIDC Clients -> Add).
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Optional -------------------------------------------------------------
# Claim that carries group names, and the group that grants admin.
OIDC_GROUP_CLAIM=groups
OIDC_ADMIN_GROUP=board-admin

# Extra admins by subject id (comma-separated), independent of groups.
# BOARD_ADMIN_SUBS=

# 0 = no limit. Set to cap uploads, e.g. 5368709120 for 5 GiB.
BOARD_MAX_UPLOAD_BYTES=0

# Behind TLS this stays true. For plain-HTTP testing on a non-localhost host,
# set false or the browser drops the session cookie.
BOARD_COOKIE_SECURE=true

# Paths (defaults suit the container).
# BOARD_DATA_DIR=/data
# BOARD_STATIC_DIR=/app/static
# BOARD_BIND=0.0.0.0:8080
